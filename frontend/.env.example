# Only needed when the API is on another domain (e.g. https://riderapi.bitevo.in). Empty = same address.
VITE_API_URL=

# Map tiles. OpenStreetMap's own tile server is fine for a small team; for a larger fleet use a tile
# provider (MapTiler, Stadia, Thunderforest…) and put its URL template and attribution here.
VITE_MAP_TILES=
VITE_MAP_ATTRIBUTION=
