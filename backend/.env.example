# Copy to backend/.env and fill in. Never commit the real .env (it holds the database password).

# MongoDB connection: use the SAME database as the admin panel, so riders see the panel's orders and
# the panel sees riders go online, pick up and deliver. Either one full URI...
MONGODB_URI=
# ...or the URL plus separate credentials (same format as the admin panel's .env):
MONGO_DB_URL=
MONGO_DB_USER=
MONGO_DB_PASSWORD=
MONGO_DB_NAME=bitevo
# Without a connection string the API uses a local JSON file (data/db.json) with demo riders and orders.

# Port for the API (default 4002; the dev script always uses 4002).
PORT=4002
HOST=127.0.0.1

# The rider app's address(es), comma separated. Needed so the browser can send the sign-in cookie.
CLIENT_ORIGIN=http://localhost:2003

# The kitchen riders pick up from: its map position, name, address and phone (shown on the order screen).
KITCHEN_LAT=
KITCHEN_LNG=
KITCHEN_NAME=BiteVo Kitchen
KITCHEN_ADDRESS=
KITCHEN_PHONE=
# The number riders call for help (Profile → Call support).
SUPPORT_PHONE=

# Riders can take unassigned orders in their zone themselves. false = only the admin panel assigns.
SELF_ASSIGN=true
# How many orders one rider may carry at once.
MAX_ACTIVE_ORDERS=2
# A rider who went online in the app and sends no location for this many minutes is set offline.
OFFLINE_AFTER_MINS=20
# Days to keep each order's driven route.
TRACK_KEEP_DAYS=30

# Road routes on the map, from an OSRM server. The public demo server is fine for trying the app; for a
# real fleet, host OSRM or use a paid routing service. Empty = straight lines on the map.
ROUTING_URL=https://router.project-osrm.org

# Google Maps for the app's map (Maps JavaScript API), the same keys as the website's backend/.env. The browser
# key draws the map on riders' phones: restrict it to the app's address in Google Cloud. Empty = uses
# GOOGLE_MAPS_KEY (fine on localhost). Both empty = OpenStreetMap, no key needed.
GOOGLE_MAPS_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# Proof of delivery: riders take camera photos of the handover (and scan the order's barcode label) before
# "Delivered". The photos go to Supabase Storage, the same project as the admin panel's photos: copy SUPABASE_URL
# and SUPABASE_SECRET_KEY from ../bitevoadminpanel/backend/.env. The bucket is created (public) on the first
# photo; file names are random. Empty = photos are kept in backend/data/photos (fine for trying the app).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DELIVERY_BUCKET=bitevo-delivery-photos

# Sign-in codes. OTP_DEV_MODE=true shows the code on screen and in this server's log instead of
# sending it. Set it to false once MINIMOTH_API_KEY is set (the same key as the website's).
OTP_DEV_MODE=true
MINIMOTH_API_KEY=

# Cookies: use COOKIE_SECURE=true on HTTPS. If the app and API are on different domains,
# also set COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_DAYS=30

# Set to true when running behind a proxy/load balancer (so rate limits and IP addresses are right).
TRUST_PROXY=false

# Minutes ahead of UTC for "today" in the rider's stats (India = 330).
UTC_OFFSET_MINS=330
